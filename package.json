{
  "name": "npm-dep-upgrader",
  "version": "1.0.0",
  "description": "Upgrade outdated npm dependencies one at a time, verified by tests, with obsolete override cleanup.",
  "type": "module",
  "private": true,
  "bin": {
    "upgrade-deps": "./upgrade-deps.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts test/e2e/*.test.ts",
    "test:unit": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
